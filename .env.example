# ==============================================================================
# SPEED BIKE RENTAL — ENVIRONMENT VARIABLES EXAMPLE
# Copy relevant sections into backend/.env and frontend/.env (never commit .env)
# ==============================================================================

# --- Backend (backend/.env) ---
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/speed-bike-rental?retryWrites=true&w=majority

# Optional: Set to true ONLY for local automated testing without MongoDB Atlas
# USE_MEMORY_DB=false

# JWT signing secret (use at least 32 random characters in production)
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGINS=http://localhost:5173

# Cookie security (set COOKIE_SAME_SITE=none and secure cookies in cross-site prod HTTPS)
COOKIE_SAME_SITE=lax

# Cloudinary credentials (for bike photos, logo and website media uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=speed-bike-rental

# First Admin Setup Script (optional non-interactive env vars for npm run create-admin)
# ADMIN_NAME=Owner Admin
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=UseAStrongUniquePassword123!

# --- Frontend (frontend/.env) ---
# Base URL of the Express API (leave empty in dev to use Vite /api proxy)
VITE_API_BASE_URL=
